@{
    var currentPage = ViewContext.RouteData.Values["page"] as string;
    string NavClass(string page) => page == currentPage ? "nav-link active" : "nav-link";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · DetroitRunner Pay</title>
    <style>
        * { box-sizing: border-box; }
        body { font-family: system-ui, sans-serif; background: #f5f5f4; color: #1c1917; margin: 0; }
        .shell { display: flex; min-height: 100vh; }

        .sidebar { width: 14rem; flex-shrink: 0; background: #1c1917; color: #e7e5e4; padding: 1.25rem 0.75rem; display: flex; flex-direction: column; }
        .brand { font-weight: 700; font-size: 1.05rem; padding: 0 0.75rem 1.25rem; color: #fff; }
        .brand small { display: block; font-weight: 400; font-size: 0.8rem; color: #a8a29e; }
        .nav { list-style: none; margin: 0; padding: 0; }
        .nav-link { display: block; padding: 0.5rem 0.75rem; border-radius: 0.375rem; color: #d6d3d1; text-decoration: none; }
        .nav-link:hover { background: #292524; color: #fff; }
        .nav-link.active { background: #44403c; color: #fff; font-weight: 600; }
        .sidebar-footer { margin-top: auto; padding: 0 0.75rem; font-size: 0.75rem; color: #78716c; }

        .content { flex: 1; min-width: 0; padding: 2rem 1rem; }

        /* On narrow screens the sidebar becomes a bar across the top. */
        @@media (max-width: 640px) {
            .shell { flex-direction: column; min-height: auto; }
            .sidebar { width: auto; flex-direction: row; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; }
            .brand { padding: 0; }
            .brand small, .sidebar-footer { display: none; }
            .nav { display: flex; gap: 0.25rem; }
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
<div class="shell">
    <nav class="sidebar" aria-label="Main">
        <div class="brand">DetroitRunner <small>Pay</small></div>
        <ul class="nav">
            <li><a class="@NavClass("/Index")" asp-page="/Index">Last month's paycheck</a></li>
        </ul>
        <div class="sidebar-footer">Showing sample data</div>
    </nav>
    <main class="content">
        @RenderBody()
    </main>
</div>
</body>
</html>
